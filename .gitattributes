# Texto con saltos LF en el repositorio, sin importar la configuracion de Git
# de quien suba los cambios (la rc.1 llego con CRLF y el diff se triplico).
* text=auto

# cmd.exe falla con call :etiqueta / goto en .bat con saltos LF.
# Forzar CRLF tambien en el ZIP que descarga GitHub.
*.bat text eol=crlf
*.cmd text eol=crlf

# Fuera del ZIP de descarga: solo sirven para el repositorio.
# Aplica al boton del README (Release) y al "Download ZIP" de GitHub.
.gitattributes export-ignore
.gitignore export-ignore
/.github export-ignore
/README.md export-ignore
/README.en.md export-ignore
/CHANGELOG.md export-ignore
/tests export-ignore
/docs export-ignore
